DATABASE_URL=

# PayMongo checkout (required for live donations)
# Get keys from https://dashboard.paymongo.com — Developers → API keys
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
# test | live  (must match the key prefix: sk_test_ vs sk_live_)
PAYMONGO_MODE=test

# Optional. Dollar labels on Support are charged in PHP at this rate.
# Default 62 — same assumption as Justin's other PayMongo checkouts.
USD_TO_PHP_RATE=62

# Optional. Used for PayMongo success/cancel URLs in production.
NEXT_PUBLIC_SITE_URL=https://ninablanca.com
